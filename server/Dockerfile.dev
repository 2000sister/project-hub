# 开发镜像：tsx watch 热重启，源码由 compose 挂载宿主目录覆盖
# 目录布局与生产镜像一致（/app/server + 同级 /app/data），保证 config.ts 的路径推导不变
FROM node:22-alpine

WORKDIR /app/server

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src

ENV NODE_ENV=development \
    HUB_PORT=5218
EXPOSE 5218

CMD ["npm", "run", "dev"]
